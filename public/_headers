# Cloudflare Workers static assets headers (ignored by Vercel).
# https://developers.cloudflare.com/workers/static-assets/headers
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Mirrors headers() in next.config.mjs: on Workers, files in public/ are served by the
# assets binding before the worker runs, so next.config headers do not reach them.
/captions/*
  Cache-Control: public, max-age=86400
