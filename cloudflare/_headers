# Workers static assets headers (copied into .open-next/assets by `npm run cf-build`).
# Static files are served by Cloudflare before the Worker runs, so the "headers" in
# next.config.mjs do not reach them; they are mirrored here.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/captions/*
  Cache-Control: public, max-age=86400
